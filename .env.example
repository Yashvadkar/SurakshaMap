# ==============================================================================
# SurakshaMap Environment Configuration Template
# Copy this file to .env and env.js for local development
# ==============================================================================

# Google Maps Platform Key (Enable Maps JavaScript API in Google Cloud Console)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Google Gemini AI Key (Get free key from Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
