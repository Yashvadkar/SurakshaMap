rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reports collection — citizens can create, admins can manage
    match /reports/{reportId} {
      // Anyone can create a report (anonymous submission)
      allow create: if true;

      // Anyone can read reports (for public map, tracking, insights)
      allow read: if true;

      // Allow update by authenticated admins or admin dashboard in demo mode
      allow update: if true;

      // Only authenticated users can delete
      allow delete: if request.auth != null;
    }
  }
}
